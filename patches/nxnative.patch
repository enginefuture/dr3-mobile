+// D3 exact-build signed-image selection. No executable bytes are written.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#define DM_D3_MAIN_BUILD_ID "2607a74f5df7754cc0357b5df7e49693"
+static inline const char *dm_d3_graphics_image(const char *mode,const char *module,const char *build_id) {
+    if(!module)return NULL;
+    if(strcmp(module,"main"))return module;
+    if(!mode||!strcmp(mode,"normal"))return module;
+    if(strcmp(mode,"wide")||!build_id||strcmp(build_id,DM_D3_MAIN_BUILD_ID))return NULL;
+    return "mainwide";
+}
+static inline int dm_d3_wide_text_valid(const uint8_t *text,size_t length) {
+    // Fixed packaged profile: 1568x720 in both modes, aspect 98/45, authored
+    // 16:9 constraint predicate disabled. This is not a generic image patcher.
+    static const struct { size_t offset;uint32_t word; } expected[]={
+        {0xe7858,0xd280c408},{0xe785c,0xd280c409},
+        {0xe7860,0xf2c05a08},{0xe7864,0xf2c05a09},
+        {0xe7868,0x528c16ca},{0xe786c,0x72a8016a},
+        {0xe7870,0xb90012ca},{0xe7874,0xa90026c8},
+        {0xebb48,0x1e2e1001},
+        {0x29b480,0x52800000},{0x29b484,0xd65f03c0},
+        {0x29b7e8,0x1e2a1802},{0x29b854,0x1e211881},
+        {0x29b914,0xbd000000},{0x29b918,0x1e211840},{0x29b91c,0xbd001400},
+    };
+    if(!text)return 0;
+    for(size_t i=0;i<sizeof expected/sizeof expected[0];i++) {
+        if(expected[i].offset>length||length-expected[i].offset<4)return 0;
+        uint32_t word;memcpy(&word,text+expected[i].offset,4);
+        if(word!=expected[i].word)return 0;
+    }
+    return 1;
+}
