+// Real MetalFX Spatial, isolated from guest render-target identity and shaders.
+// Owned by the presentation thread. Reuse a slot only after its present ticket
+// completes: Metal 4 does not retain its resources until GPU completion.
+#pragma once
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#import <Foundation/Foundation.h>
