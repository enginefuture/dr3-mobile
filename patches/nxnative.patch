--- /dev/null
+++ b/dm/host/hle_lan_native.c
@@ -0,0 +1,156 @@
+/* Wi-Fi room control. No Switch IPC, UI, guest addresses or public-network dial. */
+#include "lan_native.h"
+#include <arpa/inet.h>
+#include <CommonCrypto/CommonHMAC.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { QUERY=1, ANNOUNCE, JOIN, JOINED, HEARTBEAT, ROSTER, LEAVE, DESTROY,
+       HEADER=40, MAC=32, MAX_PACKET=HEADER+0x480+MAC, MAX_TARGETS=32 };
+typedef struct { struct sockaddr_in address; dm_lan_network_info info; uint64_t seen; } candidate;
+typedef struct { uint64_t id, seen; struct sockaddr_in address; } peer;
+static struct {
+    pthread_mutex_t mutex; pthread_cond_t changed; pthread_t thread;
+    int initialized,stop,suspended,state,fd,discovery,reason,joining,join_result;
+    uint32_t ip,mask; uint16_t port; uint64_t identity,request,last_host;
+    dm_lan_network_info info; dm_lan_security security; dm_lan_user user;
+    uint8_t changes[8]; peer peers[8];
+    candidate targets[MAX_TARGETS]; unsigned target_count;
+    struct sockaddr_in host; uint8_t pending_session[16]; void (*change_handler)(void);
+} L={.mutex=PTHREAD_MUTEX_INITIALIZER,.changed=PTHREAD_COND_INITIALIZER,.fd=-1};
+void dm_lan_set_change_handler(void (*handler)(void)){pthread_mutex_lock(&L.mutex);L.change_handler=handler;pthread_mutex_unlock(&L.mutex);}
+static void change_locked(void){pthread_cond_broadcast(&L.changed);if(L.change_handler)L.change_handler();}
+static uint64_t clock_ms(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return (uint64_t)t.tv_sec*1000+t.tv_nsec/1000000; }
+static struct timespec deadline(unsigned ms) { struct timespec t;clock_gettime(CLOCK_REALTIME,&t);t.tv_sec+=ms/1000;t.tv_nsec+=(ms%1000)*1000000L;if(t.tv_nsec>=1000000000L){t.tv_sec++;t.tv_nsec-=1000000000L;}return t; }
+static uint16_t get16(const uint8_t *p){return ((uint16_t)p[0]<<8)|p[1];}
+static uint32_t get32(const uint8_t *p){return ((uint32_t)get16(p)<<16)|get16(p+2);}
+static uint64_t get64(const uint8_t *p){return ((uint64_t)get32(p)<<32)|get32(p+4);}
+static void put16(uint8_t *p,uint16_t v){p[0]=v>>8;p[1]=v;}
+static void put32(uint8_t *p,uint32_t v){put16(p,v>>16);put16(p+2,v);}
+static void put64(uint8_t *p,uint64_t v){put32(p,v>>32);put32(p+4,v);}
