+#define PROG_SNAPSHOT_MAGIC MAGIC('P','S','N','P')
+typedef struct { prog_t program; uint8_t keys[6][8]; } prog_snapshot_t;
+static inline int prog_snapshot_capture(prog_snapshot_t *out,const prog_t *source,
+                                        int (*get_key)(const prog_t *,unsigned,uint8_t[8])) {
+    if(!source || source->magic!=MAGIC('P','R','O','G') || source->nstage>6)return 0;
+    prog_snapshot_t snapshot={0};snapshot.program=*source;
+    for(unsigned i=0;i<source->nstage;i++)if(!get_key(source,i,snapshot.keys[i]))return 0;
+    snapshot.program.magic=PROG_SNAPSHOT_MAGIC;*out=snapshot;return 1;
+}
+static inline int prog_snapshot_key(const prog_t *program,unsigned stage,uint8_t key[8]) {
+    if(!program || program->magic!=PROG_SNAPSHOT_MAGIC || program->nstage>6 || stage>=program->nstage)return 0;
+    const prog_snapshot_t *snapshot=(const prog_snapshot_t *)program;
+    memcpy(key,snapshot->keys[stage],8);return 1;
+}
+static inline const prog_t *prog_snapshot_bind(prog_snapshot_t *slot,const prog_t *recorded) {
+    if(!recorded){memset(slot,0,sizeof *slot);return NULL;}
+    if(recorded->magic!=PROG_SNAPSHOT_MAGIC || recorded->nstage>6)return NULL;
+    *slot=*(const prog_snapshot_t *)recorded;return &slot->program;
+}
