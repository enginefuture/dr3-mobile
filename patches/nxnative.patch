+// D3 creates a stack-local AOC SystemEvent on every poll. The same address is
+// reused after DestroySystemEvent; remove its side-table binding before the
+// SDK closes the handles, otherwise the next Create is incorrectly skipped.
+HLE_FORCE("_ZN2nn2os18DestroySystemEventEPNS0_15SystemEventTypeE", "Retire service-event binding before SDK destruction", void, h_service_event_destroy, void *ev) {
+    pthread_mutex_lock(&g_se_lock);
+    for (int i = 0; i < g_nse; ++i) if (g_se[i].ev == ev) {
+        g_se[i] = g_se[--g_nse];
+        break;
+    }
+    pthread_mutex_unlock(&g_se_lock);
+    void (*destroy)(void *) = guest_sym("_ZN2nn2os18DestroySystemEventEPNS0_15SystemEventTypeE");
+    if (!destroy) die("Missing SDK DestroySystemEvent");
+    destroy(ev);
+}
+
 void hle_signal_system_event(void *ev) {   // An unbound one is bound on the spot as manual-clear (can only happen on a guest thread)
     pthread_mutex_lock(&g_se_lock); uint32_t wh = se_find(ev); pthread_mutex_unlock(&g_se_lock);
     if (!wh) { hle_bind_system_event(ev, 0); pthread_mutex_lock(&g_se_lock); wh = se_find(ev); pthread_mutex_unlock(&g_se_lock); }
