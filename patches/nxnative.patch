+typedef struct { NSUInteger x,y,width,height; } nvn_fx_rect;
+typedef void (^nvn_fx_resource_hook)(id<MTLResource> resource);
+
+@interface NVNSpatialUpscaler:NSObject {
+    id<MTLDevice> _device;
+    id<MTLCommandQueue> _queue;
+    id<MTL4CommandQueue> _queue4;
+    id<MTLSharedEvent> _bridge;
