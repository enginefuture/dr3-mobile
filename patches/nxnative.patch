diff --git a/dm/gfx/nvn/nvn_uniform_forward.h b/dm/gfx/nvn/nvn_uniform_forward.h
new file mode 100644
index 0000000..45ca651
--- /dev/null
+++ b/dm/gfx/nvn/nvn_uniform_forward.h
@@ -0,0 +1,53 @@
+// Exact-range uniform versions. Guest writes are deferred only while every
+// intervening GPU reader is either disjoint or redirected to a complete version.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#define UF_MAX 64
+typedef struct { uint64_t dst, size, offset, gpu; void *buffer; } uf_version;
+typedef struct { uf_version v[UF_MAX]; unsigned n; } uf_plan;
+static inline int uf_overlap(uint64_t a, uint64_t n, uint64_t b, uint64_t m) {
+    if (!n || !m) return 0;
+    if (a > UINT64_MAX - n || b > UINT64_MAX - m) return 1;
+    return a < b + m && b < a + n;
+}
+static inline int uf_slot(const uf_plan *p, uint64_t dst, uint64_t size) {
+    if (!size || dst > UINT64_MAX - size) return -1;
+    for (unsigned i=0;i<p->n;i++) {
+        if (p->v[i].dst == dst && p->v[i].size == size) return (int)i;
+        if (uf_overlap(dst,size,p->v[i].dst,p->v[i].size)) return -1;
+    }
+    return p->n < UF_MAX ? (int)p->n : -1;
+}
+static inline int uf_put(uf_plan *p, uf_version v) {
+    int slot=uf_slot(p,v.dst,v.size); if(slot<0)return 0;
+    p->v[slot]=v; if((unsigned)slot==p->n)p->n++; return 1;
+}
+static inline int uf_hits(const uf_plan *p,uint64_t addr,uint64_t size) {
+    for(unsigned i=0;i<p->n;i++)if(uf_overlap(addr,size,p->v[i].dst,p->v[i].size))return 1;
+    return 0;
+}
+static inline const uf_version *uf_find(const uf_plan *p,uint64_t addr,uint64_t size) {
+    if(!size || addr>UINT64_MAX-size)return NULL;
+    for(unsigned i=0;i<p->n;i++)if(addr>=p->v[i].dst && addr+size<=p->v[i].dst+p->v[i].size)return &p->v[i];
+    return NULL;
+}
+
+// A forwarded uniform no longer forces the original copy/render boundary.
+// Preserve visibility when a later draw samples a previously written attachment.
+typedef struct { uint64_t serial, address, size; } uf_attachment;
+static inline int uf_attachment_alias(uf_attachment a, uf_attachment b) {
+    if (a.serial && a.serial == b.serial) return 1;
+    if (!a.address || !b.address) return 0; // Distinct host-only storage.
+    if (!a.size || !b.size) return 1;      // Unknown guest-backed extent.
+    return uf_overlap(a.address,a.size,b.address,b.size);
+}
+static inline unsigned uf_attachment_dependencies(uf_attachment sampled,
+                                                  const uf_attachment *attachments,
+                                                  unsigned n, unsigned written) {
+    unsigned hits=0;
+    for(unsigned i=0;i<n && i<9;i++)
+        if((written & (1u<<i)) && uf_attachment_alias(sampled,attachments[i]))hits|=1u<<i;
+    return hits;
+}
diff --git a/dm/gfx/nvn/nvn_vertex_fetch.h b/dm/gfx/nvn/nvn_vertex_fetch.h
new file mode 100644
index 0000000..c2b4657
--- /dev/null
+++ b/dm/gfx/nvn/nvn_vertex_fetch.h
@@ -0,0 +1,64 @@
+// Entry interfaces follow the actual vertex fetch format. Internal registers
+// retain the original translator's bit interpretation, including signed extension.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <stdint.h>
+
+#define NVN_VERTEX_FETCH_REVISION 1
+enum { NVN_FETCH_FLOAT=0, NVN_FETCH_UINT=1, NVN_FETCH_INT=2, NVN_FETCH_UNKNOWN=255 };
+
+static inline int nvn_vertex_fetch_type(unsigned format) {
+    switch(format) {
+        case 0x03:case 0x08:case 0x0b:case 0x0f:case 0x14:case 0x17:
+        case 0x1b:case 0x20:case 0x23:case 0x27:case 0x2c:case 0x2f:return NVN_FETCH_UINT;
+        case 0x04:case 0x09:case 0x0c:case 0x10:case 0x15:case 0x18:
+        case 0x1c:case 0x21:case 0x24:case 0x28:case 0x2d:case 0x30:return NVN_FETCH_INT;
+        case 0x01:case 0x02:case 0x05:case 0x06:case 0x07:case 0x0a:
+        case 0x0d:case 0x0e:case 0x11:case 0x12:case 0x13:case 0x16:
+        case 0x19:case 0x1a:case 0x1d:case 0x1e:case 0x1f:case 0x22:
+        case 0x25:case 0x26:case 0x29:case 0x2a:case 0x2b:case 0x2e:
+        case 0x3d:case 0x69:case 0x3f:case 0x9a:return NVN_FETCH_FLOAT;
+        default:return NVN_FETCH_UNKNOWN;
+    }
+}
+
+// 0 means unchanged; desired type + 1 occupies two bits for each Metal location.
+static inline uint64_t nvn_vertex_fetch_set(uint64_t signature,unsigned location,unsigned type) {
+    if(location>=32 || type>2)return signature;
+    return (signature & ~(UINT64_C(3)<<(location*2))) | ((uint64_t)(type+1)<<(location*2));
+}
+
+static NSString *nvn_vertex_fetch_adapt(NSString *source,uint64_t signature,NSString **why) {
+    if(!signature)return source;
+    NSRegularExpression *structure=[NSRegularExpression regularExpressionWithPattern:@"struct\\s+main0_in\\s*\\{([\\s\\S]*?)\\};" options:0 error:nil];
+    NSTextCheckingResult *input=[structure firstMatchInString:source options:0 range:NSMakeRange(0,source.length)];
+    NSRange entry=[source rangeOfString:@"vertex main0_out main0("];
+    if(!input || entry.location==NSNotFound) {if(why)*why=@"unrecognized generated vertex entry";return nil;}
+    NSRange brace=[source rangeOfString:@"{" options:0 range:NSMakeRange(entry.location,source.length-entry.location)];
+    if(brace.location==NSNotFound) {if(why)*why=@"vertex body absent";return nil;}
+    NSMutableString *head=[[source substringToIndex:brace.location+1] mutableCopy];
+    NSMutableString *body=[[source substringFromIndex:brace.location+1] mutableCopy];
+    NSMutableString *aliases=[NSMutableString string];uint64_t seen=0;
+    NSRegularExpression *attribute=[NSRegularExpression regularExpressionWithPattern:@"\\b(float|uint|int)([234]?)\\s+(\\w+)\\s*\\[\\[attribute\\((\\d+)\\)\\]\\]" options:0 error:nil];
+    NSArray<NSTextCheckingResult *> *matches=[attribute matchesInString:source options:0 range:[input rangeAtIndex:1]];
+    const char *types[]={"float","uint","int"};
+    for(NSTextCheckingResult *m in matches.reverseObjectEnumerator) {
+        unsigned loc=(unsigned)[[source substringWithRange:[m rangeAtIndex:4]] intValue];
+        if(loc>=32)continue;
+        unsigned requested=(unsigned)((signature>>(loc*2))&3);if(!requested)continue;
+        if(seen&(UINT64_C(3)<<(loc*2))) {if(why)*why=@"duplicate vertex attribute";return nil;}
+        seen|=(uint64_t)requested<<(loc*2);
+        NSString *original=[source substringWithRange:[m rangeAtIndex:1]], *width=[source substringWithRange:[m rangeAtIndex:2]], *member=[source substringWithRange:[m rangeAtIndex:3]];
+        NSString *newType=[NSString stringWithUTF8String:types[requested-1]];
+        if([newType isEqualToString:original]) {if(why)*why=@"redundant requested attribute transform";return nil;}
+        NSString *alias=[@"dm_fetch_" stringByAppendingString:member];
+        if([source rangeOfString:alias].location!=NSNotFound) {if(why)*why=@"vertex alias collision";return nil;}
+        NSRegularExpression *use=[NSRegularExpression regularExpressionWithPattern:[NSString stringWithFormat:@"\\bin\\.%@\\b",[NSRegularExpression escapedPatternForString:member]] options:0 error:nil];
+        if(![use numberOfMatchesInString:body options:0 range:NSMakeRange(0,body.length)]) {if(why)*why=@"attribute access is not recognized";return nil;}
+        body=[[use stringByReplacingMatchesInString:body options:0 range:NSMakeRange(0,body.length) withTemplate:alias] mutableCopy];
+        [aliases appendFormat:@"\n    %@%@ %@ = as_type<%@%@>(in.%@);",original,width,alias,original,width,member];
+        [head replaceCharactersInRange:[m rangeAtIndex:1] withString:newType];
+    }
+    if(seen!=signature) {if(why)*why=@"requested vertex location is absent";return nil;}
+    return [[head stringByAppendingString:aliases] stringByAppendingString:body];
+}
