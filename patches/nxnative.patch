+    id<MTLFXSpatialScaler> _scalers[3];
+    id<MTLTexture> _inputs[3],_outputs[3];
+    id<MTLRenderPipelineState> _copyPipeline;
+    id<MTLSamplerState> _nearest;
+    nvn_fx_resource_hook _add,_remove;
+    dispatch_block_t _commit;
+    _Atomic int _failed;
+    _Atomic uint64_t _completed,_gpuSpanNs;
+}
+- (instancetype)initWithDevice:(id<MTLDevice>)device queue:(id<MTLCommandQueue>)queue queue4:(id<MTL4CommandQueue>)queue4
+                   resourceAdd:(nvn_fx_resource_hook)add resourceRemove:(nvn_fx_resource_hook)remove resourceCommit:(dispatch_block_t)commit;
+- (id<MTLTexture>)encodeSource:(id<MTLTexture>)source crop:(nvn_fx_rect)crop canvasWidth:(NSUInteger)width canvasHeight:(NSUInteger)height slot:(unsigned)slot error:(NSError **)error;
+- (NSDictionary *)diagnosticsForSlot:(unsigned)slot;
+@end
+
+@implementation NVNSpatialUpscaler
+static void nvn_fx_error(NSError **error,NSString *message) {
+    if(error)*error=[NSError errorWithDomain:@"NVNMetalFXSpatial" code:1 userInfo:@{NSLocalizedDescriptionKey:message}];
+}
+- (instancetype)initWithDevice:(id<MTLDevice>)device queue:(id<MTLCommandQueue>)queue queue4:(id<MTL4CommandQueue>)queue4
+                   resourceAdd:(nvn_fx_resource_hook)add resourceRemove:(nvn_fx_resource_hook)remove resourceCommit:(dispatch_block_t)commit {
+    if(!(self=[super init]))return nil;
+    if(!device || !queue || !queue4 || ![MTLFXSpatialScalerDescriptor supportsDevice:device])return nil;
+    _device=device;_queue=queue;_queue4=queue4;_add=[add copy];_remove=[remove copy];_commit=[commit copy];
+    _bridge=[device newSharedEvent];if(!_bridge)return nil;
+    NSString *source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+      "struct V {float4 p [[position]];float2 uv;};\n"
+      "vertex V copy_vs(uint id [[vertex_id]]){float2 uv=float2((id<<1)&2,id&2);V o;o.p=float4(uv*float2(2,-2)+float2(-1,1),0,1);o.uv=uv;return o;}\n"
+      "fragment float4 copy_fs(V in [[stage_in]],texture2d<float> t [[texture(0)]],sampler s [[sampler(0)]],constant float4& r [[buffer(0)]]){return float4(t.sample(s,in.uv*r.zw+r.xy).rgb,1);}\n";
+    NSError *error=nil;id<MTLLibrary> library=[device newLibraryWithSource:source options:nil error:&error];
+    if(!library)return nil;
