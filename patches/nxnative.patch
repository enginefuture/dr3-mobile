new file mode 100644
index 0000000..06df5cf
--- /dev/null
+++ b/dm/gfx/nvn/nvn_command_copy.h
@@ -0,0 +1,55 @@
+// Bounded command-copy planner. Control-flow records are flattened before the
+// destination allocator runs, so source memory can alias a destination grant.
+#pragma once
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct { uint8_t *bytes; size_t size, capacity; uint32_t records; } nvn_copy_plan;
+typedef int (*nvn_copy_range_fn)(const void *, size_t);
+typedef int (*nvn_copy_handle_fn)(uint64_t);
+static inline int nvn_copy_append(nvn_copy_plan *plan, const void *bytes, uint32_t size) {
+    const size_t limit = 64u << 20;
+    if (size > limit - plan->size || plan->records >= 1000000) return 0;
+    if (plan->size + size > plan->capacity) {
+        size_t cap = plan->capacity ? plan->capacity : 1024;
+        while (cap < plan->size + size) cap *= 2;
+        void *p = realloc(plan->bytes, cap); if (!p) return 0;
+        plan->bytes = p; plan->capacity = cap;
+    }
+    memcpy(plan->bytes + plan->size, bytes, size); plan->size += size; plan->records++; return 1;
+}
+static inline int nvn_copy_collect(nvn_copy_plan *plan, uint64_t handle,
+                                   nvn_copy_range_fn range, nvn_copy_handle_fn known,
+                                   uint64_t active[16], unsigned depth) {
+    if (depth >= 16 || !known(handle)) return 0;
+    for (unsigned i = 0; i < depth; i++) if (active[i] == handle) return 0;
+    active[depth] = handle;
+    const uint8_t *p = (const uint8_t *)(uintptr_t)handle;
+    if (!range(p, 8)) return 0;
+    op_hdr first; memcpy(&first, p, 8);
+    if (first.op != OP_BEGIN || first.size != 8) return 0;
+    for (unsigned guard = 0; guard < 1000000; guard++) {
+        if (((uintptr_t)p & 7) || !range(p, 8)) return 0;
+        op_hdr h; memcpy(&h, p, 8);
+        if (h.op >= OP_COUNT_ || h.size < 8 || (h.size & 7) || !range(p, h.size)) return 0;
+        if (h.op == OP_BEGIN) { if (h.size != 8) return 0; }
+        else if (h.op == OP_END) return h.size == 8;
+        else if (h.op == OP_JUMP || h.op == OP_CALL) {
+            if (h.size != 16) return 0;
+            uint64_t target; memcpy(&target, p + 8, 8);
+            if (h.op == OP_JUMP) { p = (const uint8_t *)(uintptr_t)target; continue; }
+            if (!nvn_copy_collect(plan, target, range, known, active, depth + 1)) return 0;
+        } else {
+            if (h.op == OP_BIND_PROGRAM && h.size < 8 + sizeof(p_bind_program)) return 0;
+            if (h.op == OP_UPDATE_UB) {
+                uint64_t n; if (h.size < 24) return 0; memcpy(&n, p + 16, 8);
+                if (n > h.size - 24) return 0;
+            }
+            if (h.op == OP_WAIT_SYNC && h.size != 16) return 0;
+            if (!nvn_copy_append(plan, p, h.size)) return 0;
+        }
+        p += h.size;
+    }
+    return 0;
+}
