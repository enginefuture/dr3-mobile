+    float rect[4]={(float)crop.x/source.width,(float)crop.y/source.height,(float)crop.width/source.width,(float)crop.height/source.height};
+    [encoder setFragmentBytes:rect length:sizeof rect atIndex:0];
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];[encoder endEncoding];
+    scaler.inputContentWidth=crop.width;scaler.inputContentHeight=crop.height;
+    scaler.colorTexture=_inputs[slot];scaler.outputTexture=_outputs[slot];
+    [scaler encodeToCommandBuffer:command];[command encodeSignalEvent:_bridge value:finished];
+    id<MTLSharedEvent> event=_bridge;
+    [command addCompletedHandler:^(id<MTLCommandBuffer> completed){
+        if(completed.error) {
+            atomic_store(&self->_failed,1);
+            fprintf(stderr,"[dm] [metalfx] GPU failure; normal presentation on following frames: %s\n",completed.error.description.UTF8String);
