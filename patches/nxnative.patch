+    pd.vertexFunction=[library newFunctionWithName:@"copy_vs"];pd.fragmentFunction=[library newFunctionWithName:@"copy_fs"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatBGRA8Unorm;
+    _copyPipeline=[device newRenderPipelineStateWithDescriptor:pd error:&error];if(!_copyPipeline)return nil;
+    MTLSamplerDescriptor *sd=[MTLSamplerDescriptor new];sd.minFilter=sd.magFilter=MTLSamplerMinMagFilterNearest;
+    sd.sAddressMode=sd.tAddressMode=MTLSamplerAddressModeClampToEdge;_nearest=[device newSamplerStateWithDescriptor:sd];
+    if(!_nearest)return nil;return self;
+}
+- (id<MTLTexture>)encodeSource:(id<MTLTexture>)source crop:(nvn_fx_rect)crop canvasWidth:(NSUInteger)width canvasHeight:(NSUInteger)height slot:(unsigned)slot error:(NSError **)error {
+    if(atomic_load(&_failed)){nvn_fx_error(error,@"A previous MetalFX GPU command failed; using normal presentation");return nil;}
+    if(!source || slot>=3 || !crop.width || !crop.height || !width || !height ||
